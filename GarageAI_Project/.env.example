# =============================================================================
# GarageTools AI - MẪU CẤU HÌNH
# Chép tệp này thành .env rồi điền giá trị thật. TUYỆT ĐỐI KHÔNG commit tệp .env
# =============================================================================

# -----------------------------------------------------------------------------
# Ứng dụng
# -----------------------------------------------------------------------------
APP_NAME=GarageTools AI
# Khóa dùng để ký cookie phiên. Ở môi trường thật phải thay bằng chuỗi ngẫu
# nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-thanh-mot-chuoi-ngau-nhien-dai-truoc-khi-trien-khai-that
DEBUG=true
# Đặt true khi chạy sau reverse proxy có HTTPS
# (tên biến phải khớp exactly với app/core/config.py)
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Cơ sở dữ liệu
# -----------------------------------------------------------------------------
# Đường dẫn tương đối tính từ thư mục gốc dự án
DATABASE_PATH=garage.db

# Ap migrations idempotent luc khoi dong (ADR-7). Tat bang false neu quan ly schema bang tay.
AUTO_MIGRATE=true

# Mui gio hien thi cho backend (luu y: du lieu ngay gio van la UTC).
TZ=Asia/Ho_Chi_Minh

# -----------------------------------------------------------------------------
# Cấu hình AI
# -----------------------------------------------------------------------------
# Nhà cung cấp (OpenAI-compatible chat/completions):
#   mock       — không gọi mạng, demo và kiểm thử (mặc định)
#   openai     — api.openai.com          (có phí)
#   groq       — api.groq.com            (free tier — khuyến nghị thử trước)
#   openrouter — openrouter.ai           (nhiều model hậu tố :free)
#   gemini     — Google AI Studio        (free tier)
#   9router    — proxy cục bộ localhost:20128 (npm i -g 9router; 60+ provider)
#   custom     — tự đặt AI_BASE_URL + AI_MODEL + AI_API_KEY
AI_PROVIDER=mock

# Khoá API. ĐỂ TRỐNG Ở ĐÂY trong tệp .env.example.
# Chỉ điền vào tệp .env cục bộ, không commit. Tên biến theo provider:
#   openai     → OPENAI_API_KEY
#   groq       → GROQ_API_KEY        (https://console.groq.com/keys)
#   openrouter → OPENROUTER_API_KEY  (https://openrouter.ai/keys)
#   gemini     → GOOGLE_API_KEY      (https://aistudio.google.com/apikey)
#   9router    → NINEROUTER_KEY      (Dashboard localhost:20128 → API Keys;
#                                     có thể để trống nếu requireApiKey=false)
# Hoặc dùng biến chung AI_API_KEY cho mọi provider.
AI_API_KEY=

# Endpoint + model. Bỏ trống để dùng preset của AI_PROVIDER.
# Ví dụ Groq: AI_BASE_URL=https://api.groq.com/openai/v1
#             AI_MODEL=openai/gpt-oss-120b
# Ví dụ OpenRouter free: AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Ví dụ Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#               AI_MODEL=gemini-2.0-flash
# Ví dụ 9router: AI_MODEL=my9model-free  (hoặc kr/claude-sonnet-4.5, oc/...)
AI_BASE_URL=
AI_MODEL=

# Tương thích ngược (vẫn đọc được nếu không set AI_* ở trên):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Thời gian chờ tối đa cho một lệnh gọi AI, tính bằng giây.
# Khi hết thời gian, hệ thống ghi nhận lỗi và chuyển sang thông báo,
# không làm treo ứng dụng.
AI_TIMEOUT=15

# Số ký tự tối đa cho ngữ cảnh gửi lên model. Vượt ngưỡng sẽ bị cắt bớt
# và ghi cảnh báo vào nhật ký.
AI_MAX_CONTEXT=6000