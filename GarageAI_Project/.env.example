# =============================================================================
# GarageTools AI - MẪU CẤU HÌNH
# Chép tệp này thành .env rồi điền giá trị thật. TUYỆT ĐỐI KHÔNG commit tệp .env
# =============================================================================

# -----------------------------------------------------------------------------
# Ứng dụng
# -----------------------------------------------------------------------------
APP_NAME=GarageTools AI
# Khóa dùng để ký cookie phiên. Ở môi trường thật phải thay bằng chuỗi ngẫu
# nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-thanh-mot-chuoi-ngau-nhien-dai-truoc-khi-trien-khai-that
DEBUG=true
# Đặt true khi chạy sau reverse proxy có HTTPS
# (tên biến phải khớp exactly với app/core/config.py)
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Cơ sở dữ liệu
# -----------------------------------------------------------------------------
# Đường dẫn tương đối tính từ thư mục gốc dự án
DATABASE_PATH=garage.db

# -----------------------------------------------------------------------------
# Cấu hình AI
# -----------------------------------------------------------------------------
# Có hai giá trị:
#   mock : chế độ dự phòng, không gọi mạng, dùng để demo và kiểm thử
#   openai: gọi thật nhà cung cấp, cần có OPENAI_API_KEY
AI_PROVIDER=mock

# Khóa API. ĐỂ TRỐNG Ở ĐÂY trong tệp .env.example.
# Chỉ điền vào tệp .env cục bộ, không chia sẻ lên mạng.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Thời gian chờ tối đa cho một lệnh gọi AI, tính bằng giây.
# Khi hết thời gian, hệ thống ghi nhận lỗi và chuyển sang thông báo,
# không làm treo ứng dụng.
AI_TIMEOUT=15

# Endpoint chat completions. Có thể là:
#   https://api.openai.com/v1            (khuyên dùng)
#   https://api.openai.com/v1/chat/completions
OPENAI_BASE_URL=https://api.openai.com/v1

# Số ký tự tối đa cho ngữ cảnh gửi lên model. Vượt ngưỡng sẽ bị cắt bớt
# và ghi cảnh báo vào nhật ký.
AI_MAX_CONTEXT=6000